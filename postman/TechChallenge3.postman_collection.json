    {
      "name": "4. Posts",
      "description": "Listagem, busca e detalhe são públicos. Criar exige token de **professor(a)**; editar/remover exige ser o(a) autor(a) do post ou **ADMIN**.",
      "item": [
        {
          "name": "Listar posts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/post",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "post"
              ]
            },
            "description": "Público. Retorna todos os posts, do mais recente para o mais antigo, com `category` e o autor incluído (`authors`)."
          },
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const posts = pm.response.json();",
                  "pm.test(\"Retorna um array\", () => pm.expect(posts).to.be.an(\"array\"));",
                  "pm.test(\"Ordenado do mais recente para o mais antigo\", () => posts.forEach((p, i) => { if (i) pm.expect(posts[i - 1].createdAt >= p.createdAt).to.be.true; }));"
                ]
              }
            }
          ]
        },
